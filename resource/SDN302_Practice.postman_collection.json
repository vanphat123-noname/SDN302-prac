      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 34000000,\n  \"stock\": 25\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{sampleProductId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{sampleProductId}}"]
        }
      }
    },
    {
      "name": "10. Task 03 - DELETE /api/products/:id (Referenced in Order - Reject 409)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{sampleProductId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{sampleProductId}}"]
        }
      }
    },
    {
      "name": "11. Task 03 - DELETE /api/products/:id (Not in Order - Success 200)",
      "request": {
        "method": "DELETE",
        "header": [
