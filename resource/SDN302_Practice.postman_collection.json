{
  "info": {
    "_postman_id": "sdn302-practice-exam",
    "name": "SDN302 Practice Exam - Customer Product Order API",
    "description": "Postman Collection for SDN302 Practical Exam",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9999",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleProductId",
      "value": "6936f4c6f2937fc51e5f7cab",
