    },
    {
      "key": "newProductId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check - Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "1. Task 02 - Auth Tokens (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('token', jsonData.token);",
              "    console.log('Token saved:', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"storeadmin\",\n  \"pass\": \"Store@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/tokens",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "tokens"]
        }
      }
    },
    {
      "name": "2. Task 02 - Auth Tokens (Fail - 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"storeadmin\",\n  \"pass\": \"WrongPassword\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/tokens",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "tokens"]
        }
      }
    },
    {
      "name": "3. Task 03 - GET /api/products (Unauthorized - 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "4. Task 03 - GET /api/products (Authorized - 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "5. Task 03 - GET /api/products/:id (Success - 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{sampleProductId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{sampleProductId}}"]
        }
      }
    },
    {
      "name": "6. Task 03 - GET /api/products/:id (Not Found - 404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/666666666666666666666666",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "666666666666666666666666"]
        }
      }
    },
    {
      "name": "7. Task 03 - POST /api/products (Success - 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData._id) {",
              "    pm.collectionVariables.set('newProductId', jsonData._id);",
              "    console.log('Created product ID:', jsonData._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sony WH-1000XM5\",\n  \"price\": 8900000,\n  \"category\": \"Headphones\",\n  \"stock\": 15\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "8. Task 03 - POST /api/products (Validation Error - 400)",
      "request": {
        "method": "POST",
        "header": [
